{
  "version": 1,
  "scope": "Claude poll rules the desktop (Rust) and the command line tool (TypeScript) must apply identically. Both suites read this file.",
  "revision": {
    "rule": "A refusal names the credential that was actually sent: the lowercase hexadecimal SHA-256 of the access token. The shared lease file carries it as refusalRevision so either process releases the other's refusal after a rotation.",
    "vectors": [
      {
        "id": "old-token",
        "token": "synthetic-old-token",
        "expected": "d953861809fb8f5a74ae8f546b7072db71433eb9df7005af6f0f3e142789db51"
      },
      {
        "id": "new-token",
        "token": "synthetic-new-token",
        "expected": "495a82f2796e30291a1aa6e186d6759392e54f2b44afd1bbccffbbe8b89412dd"
      }
    ]
  },
  "schedule": {
    "rule": "After a successful Claude read the next read is due at the earlier of five minutes and the next reset still ahead of that read. A reset at or before the read, or an unknown one, is ignored. A failure keeps its own backoff: a rate limit doubles from sixty seconds to a fifteen minute cap and honours Retry-After up to seven days; a refusal waits a day whatever Retry-After says. The desktop adds its own small jitter after the success deadline.",
    "success": [
      {
        "id": "cadence-when-no-reset-is-near",
        "now": "2026-10-11T10:00:00.000Z",
        "resetAts": [
          "2026-10-11T14:00:00.000Z",
          "2026-10-15T04:00:00.000Z"
        ],
        "expected": "2026-10-11T10:05:00.000Z"
      },
      {
        "id": "reset-before-the-cadence",
        "now": "2026-10-11T03:58:00.000Z",
        "resetAts": [
          "2026-10-15T04:00:00.000Z",
          "2026-10-11T04:00:00.000Z"
        ],
        "expected": "2026-10-11T04:00:00.000Z"
      },
      {
        "id": "reset-exactly-at-the-cadence",
        "now": "2026-10-11T03:55:00.000Z",
        "resetAts": [
          "2026-10-11T04:00:00.000Z"
        ],
        "expected": "2026-10-11T04:00:00.000Z"
      },
      {
        "id": "reset-just-after-the-cadence",
        "now": "2026-10-11T03:55:00.000Z",
        "resetAts": [
          "2026-10-11T04:00:00.001Z"
        ],
        "expected": "2026-10-11T04:00:00.000Z"
      },
      {
        "id": "reset-one-millisecond-ahead",
        "now": "2026-10-11T03:59:59.999Z",
