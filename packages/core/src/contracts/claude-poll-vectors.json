  "freshness": {
    "rule": "A Claude reading a poll wrote, from the desktop or the command line, is fresh for 465 seconds: the five minute cadence, the desktop jitter of up to a fifth of it, one collector tick of sixty seconds that comes late, two requests of the whole fifteen second timeout (the reading is stamped when its request starts, and the next deadline counts from completion), and a fifteen second margin. Fresh while observedAt <= now < observedAt + 465 s. A status line payload and every other provider keep their own horizons.",
    "vectors": [
      {
        "id": "desktop-worst-healthy-schedule",
        "provider": "CLAUDE",
        "writer": "desktop",
        "sourceClass": "internal_payload",
        "observedAt": "2026-10-11T10:00:00.000Z",
        "now": "2026-10-11T10:07:44.999Z",
        "expected": {
          "ttlSeconds": 465,
          "expiresAt": "2026-10-11T10:07:45.000Z",
          "availability": "fresh"
        }
      },
      {
        "id": "desktop-one-horizon-old",
