  "freshness": {
    "rule": "A Claude reading a poll wrote, from the desktop or the command line, is fresh for 435 seconds: the five minute cadence, the desktop jitter of up to a fifth of it, one collector tick of sixty seconds that comes late, and one fifteen second request. Fresh while observedAt <= now < observedAt + 435 s. A status line payload and every other provider keep their own horizons.",
    "vectors": [
      {
        "id": "desktop-worst-healthy-schedule",
        "provider": "CLAUDE",
        "writer": "desktop",
        "sourceClass": "internal_payload",
        "observedAt": "2026-10-11T10:00:00.000Z",
        "now": "2026-10-11T10:07:14.999Z",
        "expected": {
          "ttlSeconds": 435,
          "expiresAt": "2026-10-11T10:07:15.000Z",
          "availability": "fresh"
        }
      },
      {
