  "commit": {
    "rule": "Committing a Claude poll read sends its session and weeklies to the authoritative file and keeps every row another source wrote in the main file, a status line payload that arrived while the read was in flight included. In the main file it replaces only the account's own remote_api rows and its ACQUISITION flag recorded no later than the read; a later flag or read stays. The rule goes by provenance and time alone: a row's writer stamp (cli or desktop) never changes it. After the commit, every row listed in kept is still in the main file and every row listed in gone is not. Rows take the source section's rowDefaults; the poll reads at observedAt, a read that stated its whole weekly set.",
    "observedAt": "2026-10-20T09:55:00.000Z",
    "poll": [
      { "ref": "session", "meter": "FIVE_HOUR", "sourceKind": "remote_api", "value": 4 },
      { "ref": "weekly", "meter": "SEVEN_DAY", "sourceKind": "remote_api", "value": 20 }
    ],
    "cases": [
      { "id": "a-payload-that-arrived-while-the-read-was-in-flight-stays",
