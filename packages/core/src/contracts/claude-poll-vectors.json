        "incoming": { "value": 90, "resetAt": null, "observedAt": "2026-10-19T12:00:00.000Z" },
        "expected": "held"
      },
      {
        "id": "a-row-marked-unavailable-keeps-time-order",
        "held": { "value": 40, "resetAt": "2026-10-19T15:00:00.000Z", "observedAt": "2026-10-19T12:00:00.000Z", "availability": "rate_limited" },
        "incoming": { "value": 39, "resetAt": "2026-10-19T15:00:00.000Z", "observedAt": "2026-10-19T12:05:00.000Z" },
        "expected": "incoming"
      },
      {
        "id": "a-weekly-lower-value-is-ignored",
        "meter": "SEVEN_DAY",
        "held": { "value": 40, "resetAt": "2026-10-22T12:00:00.000Z", "observedAt": "2026-10-19T12:00:00.000Z" },
        "incoming": { "value": 39, "resetAt": "2026-10-22T12:00:00.000Z", "observedAt": "2026-10-19T12:05:00.000Z" },
        "expected": "held"
      },
      {
        "id": "a-weekly-model-bucket-higher-value-observed-earlier-wins",
        "meter": "SEVEN_DAY_FABLE",
        "held": { "value": 50, "resetAt": "2026-10-22T12:00:00.000Z", "observedAt": "2026-10-19T12:05:00.000Z" },
        "incoming": { "value": 60, "resetAt": "2026-10-22T12:00:00.000Z", "observedAt": "2026-10-19T12:00:00.000Z" },
        "expected": "incoming"
      },
      {
        "id": "a-new-weekly-window-replaces-a-higher-value",
        "meter": "SEVEN_DAY",
        "held": { "value": 95, "resetAt": "2026-10-22T12:00:00.000Z", "observedAt": "2026-10-22T12:05:00.000Z" },
        "incoming": { "value": 2, "resetAt": "2026-10-29T12:00:00.000Z", "observedAt": "2026-10-22T12:02:00.000Z" },
        "expected": "incoming"
      },
      {
        "id": "claude-extra-usage-keeps-time-order",
        "meter": "EXTRA_USAGE",
        "held": { "value": 40, "resetAt": "2026-11-01T00:00:00.000Z", "observedAt": "2026-10-19T12:00:00.000Z" },
        "incoming": { "value": 10, "resetAt": "2026-11-01T00:00:00.000Z", "observedAt": "2026-10-19T12:05:00.000Z" },
        "expected": "incoming"
      },
      {
        "id": "another-provider-keeps-time-order",
        "provider": "CODEX",
        "held": { "value": 40, "resetAt": "2026-10-19T15:00:00.000Z", "observedAt": "2026-10-19T12:00:00.000Z" },
        "incoming": { "value": 10, "resetAt": "2026-10-19T15:00:00.000Z", "observedAt": "2026-10-19T12:05:00.000Z" },
