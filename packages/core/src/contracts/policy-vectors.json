{
  "version": 1,
  "scope": "L0a1.3 policy contract vectors; implementations are deferred to L1a.",
  "decisions": {
    "attemptCount": "Zero means the first retry. Local exponential delay is capped before additive nonnegative jitter.",
    "retryAfter": "Raw HTTP header, either integer seconds or an HTTP date. Invalid and negative seconds act as absent. Past dates cannot shorten the local delay.",
    "ceilings": "Ceilings change the blocked state, never shorten the server deadline. Equality is allowed; exceeding the layer ceiling blocks until the server date.",
    "lease": "One lease per acquisition key shared by desktop and CLI. A live lease denies another acquisition even for the same owner. Equality means expired. Takeover means replacing a different owner.",
    "freshness": "Fresh while observedAt <= now < expiresAt. Future observations are unavailable.",
    "proposedValues": "Pending plan confirmation: native_payload TTL 60 s; documented_api, internal_payload and local_file TTL 300 s; lease 60 s. These are explicit proposed contract values, not claims about existing implementations."
  },
