{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  /* Only the default build directory's generated route types, plus this wave's.
     Next writes one of these entries per OL_DIST_DIR it builds into, so the list
     had grown a line per finished agent lane, and every one of them still
     described routes at their old paths. After the routes moved under
     app/[locale] those stale files stopped compiling, which would have failed the
     build on artifacts nobody was using. A lane that needs its own entry gets it
     written back automatically the first time it builds. */
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-i18n/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
