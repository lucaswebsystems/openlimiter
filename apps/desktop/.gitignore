# Built by scripts/build-ui.mjs from the compiled packages. Keep an empty
# directory in clean checkouts so Tauri's compile-time config validation does
# not make `cargo test` depend on a prior frontend build.
ui/dist/*
!ui/dist/.gitkeep
# Rust build output.
src-tauri/target/
# Generated by tauri-build at compile time.
src-tauri/gen/
# Written by the release workflow when Windows signing secrets exist.
src-tauri/tauri.signing.conf.json
node_modules/
