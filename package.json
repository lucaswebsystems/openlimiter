{
  "name": "openlimiter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "test:compile": "tsc -p tsconfig.test.json",
    "vitest:safe": "node --require ./scripts/vitest-bootstrap.cjs ./node_modules/vitest/vitest.mjs",
    "test": "pnpm test:compile && pnpm vitest:safe run --configLoader runner --config vitest.config.mjs"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "license": "Apache-2.0"
}
