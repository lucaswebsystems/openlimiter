{
  "name": "@openlimiter/monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "openlimiter": "node packages/cli/dist/bin.js",
    "test:compile": "tsc -p tsconfig.test.json",
    "test:specs": "node scripts/validate-provider-specs.mjs",
    "specs:emit": "node scripts/validate-provider-specs.mjs --emit",
    "vitest:safe": "node --require ./scripts/vitest-bootstrap.cjs ./node_modules/vitest/vitest.mjs",
    "test": "pnpm test:specs && pnpm test:compile && pnpm vitest:safe run --configLoader runner --config vitest.config.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && pnpm -r publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "license": "Apache-2.0"
}
